" ~/.vim/config/options.vim

set number
set relativenumber
set termguicolors
set signcolumn=yes
set timeoutlen=300

" On pressing tab, insert 2 spaces
set expandtab

" show existing tab with 2 spaces width
set tabstop=2
set softtabstop=2

" when indenting with '>', use 2 spaces width
set shiftwidth=2


set laststatus=2
set noshowmode

set ignorecase
set smartcase
set wildignorecase

let g:netrw_banner = 0

set clipboard=
